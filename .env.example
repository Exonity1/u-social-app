# Wird von `npm run db:start` automatisch als .env.local angelegt (nicht committet).
# Entwicklung läuft gegen das lokale Supabase: Werte aus `npx supabase status`
# (API URL und anon bzw. publishable key). Mit dem Handy per USB (npm run dev:usb)
# bleibt die URL 127.0.0.1 – adb reverse leitet sie zum Laptop weiter.
# Niemals den service_role- bzw. secret-Key verwenden.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
