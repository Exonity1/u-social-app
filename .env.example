# Kopieren nach .env.local (wird nicht committet) und Werte eintragen.
# Lokal: Werte aus `npx supabase status` (API URL und anon bzw. publishable key).
# Auf dem Handy (Expo Go) statt 127.0.0.1 die LAN-IP deines PCs eintragen,
# z. B. http://192.168.178.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
